{
  "name": "brinebound",
  "private": true,
  "version": "1.0.0",
  "description": "An original pirate side-scrolling platformer for the browser: run, jump, slash and parry across three islands.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "solve": "node tools/solve.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
